# ==============================================================================
# KEKEGO — Production Environment Variables Configuration Template
# Populate these values in your production orchestrator, AWS Parameter Store,
# Doppler, or server .env.production file.
# ==============================================================================

# Core Application Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=https://admin.kekego.ng,https://kekego.ng

# PostgreSQL 16 + PostGIS Spatial Database
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
POSTGRES_USER=kekego_prod
POSTGRES_PASSWORD=replace_with_high_entropy_secret_from_generate_secrets_mjs
POSTGRES_DB=kekego_production
DATABASE_URL=postgresql://kekego_prod:replace_with_high_entropy_secret_from_generate_secrets_mjs@postgres:5432/kekego_production?schema=public&sslmode=prefer

# Redis 7 (Caching, Concurrency Locks, Rate Limiting)
REDIS_PASSWORD=replace_with_high_entropy_secret_from_generate_secrets_mjs
REDIS_URL=redis://:replace_with_high_entropy_secret_from_generate_secrets_mjs@redis:6379

# Cryptographic Token Signatures
# Generate using: node scripts/generate-secrets.mjs
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_64_byte_hex_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BOOTSTRAP_ADMIN_SECRET=replace_with_32_byte_hex_secret

# Paystack Payment Gateway (LIVE Mode)
# In production, obtain these from Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_replace_with_live_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_replace_with_live_public_key
PAYSTACK_WEBHOOK_SECRET=wh_sec_replace_with_webhook_secret

# Google Maps Platform (Multi-Tier Credential Isolation)
# 1. Server API Key (IP restricted; Places API New, Routes API v2, Geocoding)
GOOGLE_MAPS_API_KEY=AIzaSy_replace_with_server_restricted_production_maps_api_key

# 2. Web Portal Client Key (HTTP Referrer restricted: https://admin.kekego.ng/*; Maps JavaScript API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy_replace_with_web_restricted_production_maps_api_key

# 3. Mobile Client Key (Android Package & SHA-1 / iOS Bundle ID restricted; Maps SDK for Android/iOS)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy_replace_with_mobile_restricted_production_maps_api_key

# Operational Geographic Service Area
DEFAULT_SERVICE_AREA_STATE=Nasarawa

# Client Application API Endpoints
NEXT_PUBLIC_API_URL=https://api.kekego.ng
EXPO_PUBLIC_API_URL=https://api.kekego.ng
