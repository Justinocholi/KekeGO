datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = []
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -------------------------------------------------------------
// Core Enums
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  DRIVER
  PASSENGER
  PARTNER
}

enum DriverVerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DriverAvailabilityStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum VehicleType {
  KEKE_NAPEP
}

enum PartnerMemberRole {
  OWNER
  MANAGER
  DISPATCHER
}

enum RideTier {
  STANDARD
  CHARTER
  CARGO
}

enum RideStatus {
  REQUESTED
  SEARCHING
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER_FOUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  WALLET
  CARD
  BANK_TRANSFER
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerCategory {
  TRIP_FARE
  PLATFORM_COMMISSION
  PARTNER_COMMISSION
  CANCELLATION_FEE
  PAYOUT
  REFUND
  WALLET_TOPUP
}

enum NotificationType {
  RIDE_UPDATE
  DRIVER_VERIFICATION
  PAYMENT
  SYSTEM_ANNOUNCEMENT
  SOS_ALERT
}

enum SupportCategory {
  FARE_DISPUTE
  LOST_ITEM
  DRIVER_BEHAVIOR
  VEHICLE_CONDITION
  SAFETY_INCIDENT
  ACCOUNT_ISSUE
}

enum TicketStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT_SOS
}

// -------------------------------------------------------------
// 1. Identity & Profiles
// -------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  phoneNumber  String   @unique @map("phone_number")
  email        String?  @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole @default(PASSENGER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  passengerProfile   PassengerProfile?
  driverProfile      DriverProfile?
  partnerMemberships PartnerMembership[]
  wallet             Wallet?
  notifications      Notification[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]
  rideEvents         RideEvent[]

  @@index([phoneNumber])
  @@index([role, isActive])
  @@map("users")
}

model PassengerProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  rating                Decimal  @default(5.00) @db.Decimal(3, 2)
  totalRides            Int      @default(0) @map("total_rides")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rides   Ride[]
  ratings Rating[]

  @@map("passenger_profiles")
}

model DriverProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  partnerId          String?                  @map("partner_id") @db.Uuid
  verificationStatus DriverVerificationStatus @default(UNVERIFIED) @map("verification_status")
  availabilityStatus DriverAvailabilityStatus @default(OFFLINE) @map("availability_status")
  licenseNumber      String?                  @unique @map("license_number")
  licenseExpiry      DateTime?                @map("license_expiry") @db.Date
  licenseImageUrl    String?                  @map("license_image_url")
  profilePhotoUrl    String?                  @map("profile_photo_url")
  rating             Decimal                  @default(5.00) @db.Decimal(3, 2)
  totalTrips         Int                      @default(0) @map("total_trips")
  acceptanceRate     Decimal                  @default(100.00) @map("acceptance_rate") @db.Decimal(5, 2)
  cancellationRate   Decimal                  @default(0.00) @map("cancellation_rate") @db.Decimal(5, 2)
  isOnline           Boolean                  @default(false) @map("is_online")
  lastActiveAt       DateTime?                @map("last_active_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner         Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  vehicles        Vehicle[]
  rides           Ride[]
  driverLocations DriverLocation[]
  wallet          Wallet?
  ratings         Rating[]

  @@index([partnerId])
  @@index([verificationStatus, availabilityStatus])
  @@index([isOnline, availabilityStatus])
  @@map("driver_profiles")
}

// -------------------------------------------------------------
// 2. Fleet & Vehicles
// -------------------------------------------------------------

model Vehicle {
  id                String      @id @default(uuid()) @db.Uuid
  driverId          String      @map("driver_id") @db.Uuid
  partnerId         String?     @map("partner_id") @db.Uuid
  type              VehicleType @default(KEKE_NAPEP)
  plateNumber       String      @unique @map("plate_number")
  make              String      @default("Bajaj")
  model             String      @default("RE 4S")
  year              Int?
  color             String      @default("Yellow")
  insuranceExpiry   DateTime?   @map("insurance_expiry") @db.Date
  inspectionExpiry  DateTime?   @map("inspection_expiry") @db.Date
  insuranceImageUrl String?     @map("insurance_image_url")
  vehicleImageUrl   String?     @map("vehicle_image_url")
  isVerified        Boolean     @default(false) @map("is_verified")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  driver  DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  partner Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  rides   Ride[]

  @@index([driverId])
  @@index([partnerId])
  @@map("vehicles")
}

model Partner {
  id                        String   @id @default(uuid()) @db.Uuid
  name                      String
  companyRegistrationNumber String?  @unique @map("company_registration_number")
  contactEmail              String   @map("contact_email")
  contactPhone              String   @map("contact_phone")
  address                   String?
  city                      String?
  state                     String   @default("Nasarawa")
  commissionRatePercent     Decimal  @default(10.00) @map("commission_rate_percent") @db.Decimal(5, 2)
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships   PartnerMembership[]
  drivers       DriverProfile[]
  vehicles      Vehicle[]
  wallet        Wallet?
  ledgerEntries LedgerEntry[]

  @@map("partners")
}

model PartnerMembership {
  id        String            @id @default(uuid()) @db.Uuid
  partnerId String            @map("partner_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      PartnerMemberRole @default(MANAGER)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@map("partner_memberships")
}

// -------------------------------------------------------------
// 3. Operating Territory & Geofencing
// -------------------------------------------------------------

model ServiceArea {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  state           String   @default("Nasarawa")
  country         String   @default("Nigeria")
  isActive        Boolean  @default(true) @map("is_active")
  boundaryGeoJson Json     @map("boundary_geojson")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fareRules FareRule[]
  rides     Ride[]

  @@map("service_areas")
}

// -------------------------------------------------------------
// 4. Pricing & Fare Rules
// -------------------------------------------------------------

model FareRule {
  id                         String   @id @default(uuid()) @db.Uuid
  serviceAreaId              String?  @map("service_area_id") @db.Uuid
  tier                       RideTier @default(STANDARD)
  baseFareKobo               Int      @map("base_fare_kobo")
  distanceFarePerKmKobo      Int      @map("distance_fare_per_km_kobo")
  timeFarePerMinKobo         Int      @map("time_fare_per_min_kobo")
  minimumFareKobo            Int      @map("minimum_fare_kobo")
  cancellationFeeKobo        Int      @default(10000) @map("cancellation_fee_kobo")
  platformCommissionPercent  Decimal  @default(15.00) @map("platform_commission_percent") @db.Decimal(5, 2)
  partnerCommissionPercent   Decimal  @default(5.00) @map("partner_commission_percent") @db.Decimal(5, 2)
  surgeMultiplier            Decimal  @default(1.00) @map("surge_multiplier") @db.Decimal(3, 2)
  isActive                   Boolean  @default(true) @map("is_active")
  version                    Int      @default(1)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceArea        ServiceArea?        @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  rides              Ride[]
  rideFareBreakdowns RideFareBreakdown[]

  @@index([serviceAreaId, tier, isActive])
  @@map("fare_rules")
}

// -------------------------------------------------------------
// 5. Rides & Real-Time Tracking
// -------------------------------------------------------------

model Ride {
  id                      String        @id @default(uuid()) @db.Uuid
  rideNumber              String        @unique @map("ride_number")
  passengerId             String        @map("passenger_id") @db.Uuid
  driverId                String?       @map("driver_id") @db.Uuid
  vehicleId               String?       @map("vehicle_id") @db.Uuid
  serviceAreaId           String?       @map("service_area_id") @db.Uuid
  fareRuleId              String?       @map("fare_rule_id") @db.Uuid
  tier                    RideTier      @default(STANDARD)
  status                  RideStatus    @default(REQUESTED)
  pickupAddress           String        @map("pickup_address")
  pickupLatitude          Decimal       @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude         Decimal       @map("pickup_longitude") @db.Decimal(10, 7)
  destinationAddress      String        @map("destination_address")
  destinationLatitude     Decimal       @map("destination_latitude") @db.Decimal(10, 7)
  destinationLongitude    Decimal       @map("destination_longitude") @db.Decimal(10, 7)
  startOtp                String        @map("start_otp") @db.VarChar(6)
  estimatedDistanceMeters Int           @map("estimated_distance_meters")
  estimatedDurationSeconds Int          @map("estimated_duration_seconds")
  actualDistanceMeters    Int?          @map("actual_distance_meters")
  actualDurationSeconds   Int?          @map("actual_duration_seconds")
  estimatedFareKobo       Int           @map("estimated_fare_kobo")
  finalFareKobo           Int?          @map("final_fare_kobo")
  cancellationReason      String?       @map("cancellation_reason")
  cancelledBy             UserRole?     @map("cancelled_by")
  paymentMethod           PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus           PaymentStatus @default(PENDING) @map("payment_status")
  requestedAt             DateTime      @default(now()) @map("requested_at") @db.Timestamptz
  assignedAt              DateTime?     @map("assigned_at") @db.Timestamptz
  arrivedAt               DateTime?     @map("arrived_at") @db.Timestamptz
  startedAt               DateTime?     @map("started_at") @db.Timestamptz
  completedAt             DateTime?     @map("completed_at") @db.Timestamptz
  cancelledAt             DateTime?     @map("cancelled_at") @db.Timestamptz

  passenger     PassengerProfile   @relation(fields: [passengerId], references: [id])
  driver        DriverProfile?     @relation(fields: [driverId], references: [id])
  vehicle       Vehicle?           @relation(fields: [vehicleId], references: [id])
  serviceArea   ServiceArea?       @relation(fields: [serviceAreaId], references: [id])
  fareRule      FareRule?          @relation(fields: [fareRuleId], references: [id])
  events        RideEvent[]
  fareBreakdown RideFareBreakdown?
  payment       Payment?
  rating        Rating?
  supportTickets SupportTicket[]

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@index([requestedAt])
  @@map("rides")
}

model RideEvent {
  id             String      @id @default(uuid()) @db.Uuid
  rideId         String      @map("ride_id") @db.Uuid
  previousStatus RideStatus? @map("previous_status")
  newStatus      RideStatus  @map("new_status")
  actorId        String?     @map("actor_id") @db.Uuid
  actorRole      UserRole    @map("actor_role")
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  ride  Ride  @relation(fields: [rideId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([rideId])
  @@map("ride_events")
}

model RideFareBreakdown {
  id                     String   @id @default(uuid()) @db.Uuid
  rideId                 String   @unique @map("ride_id") @db.Uuid
  fareRuleId             String?  @map("fare_rule_id") @db.Uuid
  fareRuleVersion        Int      @default(1) @map("fare_rule_version")
  currency               String   @default("NGN")
  baseFareKobo           Int      @map("base_fare_kobo")
  distanceChargeKobo     Int      @map("distance_charge_kobo")
  timeChargeKobo         Int      @map("time_charge_kobo")
  cancellationFeeKobo    Int      @default(0) @map("cancellation_fee_kobo")
  surgeMultiplier        Decimal  @default(1.00) @map("surge_multiplier") @db.Decimal(3, 2)
  discountKobo           Int      @default(0) @map("discount_kobo")
  subtotalKobo           Int      @map("subtotal_kobo")
  totalFareKobo          Int      @map("total_fare_kobo")
  platformCommissionKobo Int      @map("platform_commission_kobo")
  partnerCommissionKobo  Int      @default(0) @map("partner_commission_kobo")
  driverEarningsKobo     Int      @map("driver_earnings_kobo")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  ride     Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  fareRule FareRule? @relation(fields: [fareRuleId], references: [id], onDelete: SetNull)

  @@map("ride_fare_breakdowns")
}

model DriverLocation {
  id          String   @id @default(uuid()) @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  heading     Float?
  speed       Float?
  accuracy    Float?
  isAvailable Boolean  @default(true) @map("is_available")
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt(sort: Desc)])
  @@map("driver_locations")
}

// -------------------------------------------------------------
// 6. Payments & Financial Ledger
// -------------------------------------------------------------

model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @unique @map("user_id") @db.Uuid
  driverId    String?  @unique @map("driver_id") @db.Uuid
  partnerId   String?  @unique @map("partner_id") @db.Uuid
  balanceKobo BigInt   @default(0) @map("balance_kobo")
  currency    String   @default("NGN")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  driver        DriverProfile?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  partner       Partner?        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@map("wallets")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  rideId                String        @unique @map("ride_id") @db.Uuid
  amountKobo            Int           @map("amount_kobo")
  currency              String        @default("NGN")
  method                PaymentMethod @default(CASH)
  status                PaymentStatus @default(PENDING)
  paystackReference     String?       @unique @map("paystack_reference")
  paystackTransactionId String?       @map("paystack_transaction_id")
  paystackStatus        String?       @map("paystack_status")
  paystackChannel       String?       @map("paystack_channel")
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model LedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  walletId         String?         @map("wallet_id") @db.Uuid
  partnerId        String?         @map("partner_id") @db.Uuid
  rideId           String?         @map("ride_id") @db.Uuid
  entryType        LedgerEntryType @map("entry_type")
  category         LedgerCategory
  amountKobo       Int             @map("amount_kobo")
  balanceAfterKobo BigInt          @map("balance_after_kobo")
  description      String
  idempotencyKey   String          @unique @map("idempotency_key")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  wallet  Wallet?  @relation(fields: [walletId], references: [id])
  partner Partner? @relation(fields: [partnerId], references: [id])

  @@index([walletId, createdAt])
  @@index([partnerId, createdAt])
  @@map("ledger_entries")
}

// -------------------------------------------------------------
// 7. Ratings, Notifications, Support & Audit
// -------------------------------------------------------------

model Rating {
  id          String   @id @default(uuid()) @db.Uuid
  rideId      String   @unique @map("ride_id") @db.Uuid
  passengerId String   @map("passenger_id") @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  score       Int      @db.SmallInt
  comment     String?
  tags        String[]
  ratedBy     UserRole @default(PASSENGER) @map("rated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  ride      Ride             @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger PassengerProfile @relation(fields: [passengerId], references: [id])
  driver    DriverProfile    @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([passengerId])
  @@map("ratings")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  body      String
  type      NotificationType @default(RIDE_UPDATE)
  metadata  Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model SupportTicket {
  id           String          @id @default(uuid()) @db.Uuid
  ticketNumber String          @unique @map("ticket_number")
  userId       String          @map("user_id") @db.Uuid
  rideId       String?         @map("ride_id") @db.Uuid
  category     SupportCategory @default(ACCOUNT_ISSUE)
  subject      String
  description  String
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(MEDIUM)
  resolvedAt   DateTime?       @map("resolved_at") @db.Timestamptz
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id])
  ride Ride? @relation(fields: [rideId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  UserRole @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
