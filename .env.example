# ==============================================
# KEKEGO — Environment Variables Configuration
# Copy this file to .env and adjust variables
# ==============================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:19006,http://localhost:8081

# PostgreSQL + PostGIS Database
DATABASE_URL=postgresql://kekego:kekego_secret@localhost:5432/kekego?schema=public

# Redis (Caching, Ephemeral state, Real-time locking)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_byte_hex_string_for_access_token
JWT_REFRESH_SECRET=replace_with_a_secure_random_64_byte_hex_string_for_refresh_token
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Paystack Payment Gateway (Sandbox / Test Mode)
PAYSTACK_SECRET_KEY=sk_test_placeholder_key
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key
PAYSTACK_WEBHOOK_SECRET=wh_sec_placeholder_key

# ==============================================
# Google Maps Platform (Multi-Tier Credential Isolation)
# ==============================================
# 1. Backend Server Key: Restricted to Server IP / APIs (Routes API, Places API New, Geocoding API)
GOOGLE_MAPS_API_KEY=placeholder_maps_server_api_key

# 2. Web Portal Client Key: Restricted to HTTP Referrers (e.g. http://localhost:3000/*, https://admin.kekego.ng/*)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=placeholder_maps_web_client_key

# 3. Mobile Apps Client Key: Restricted to Android Package & SHA-1 / iOS Bundle ID
EXPO_PUBLIC_GOOGLE_MAPS_KEY=placeholder_maps_mobile_client_key

# Default Service Area Boundary
DEFAULT_SERVICE_AREA_STATE=Nasarawa

# Client Application URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
